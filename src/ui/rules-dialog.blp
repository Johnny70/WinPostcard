using Gtk 4.0;
using Adw 1;

template $PostcardRulesDialog: Adw.Dialog {
    title: _("Rules");
    content-width: 480;
    content-height: 480;

    child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        content: Gtk.ScrolledWindow {
            child: Adw.PreferencesPage {
                Adw.PreferencesGroup rules_group {
                    title: _("Move Mail Automatically");
                    description: _("Mail from a sender below moves to its folder as soon as it arrives — it never shows up in the inbox first.");

                    [header-suffix]
                    Gtk.Button add_button {
                        icon-name: "list-add-symbolic";
                        tooltip-text: _("Add Rule");

                        styles ["flat"]
                      }
                  }
              };
          };
      };
  }
